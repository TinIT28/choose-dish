{
  "name": "choose-dish",
  "private": true,
  "packageManager": "bun@1.3.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun --workspaces run dev",
    "build": "bun --workspaces run build",
    "test": "bun --workspaces run test",
    "typecheck": "bun --workspaces run typecheck",
    "lint": "bun --workspaces run lint",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "test:e2e": "playwright test"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "argon2",
    "core-js",
    "esbuild",
    "prisma"
  ],
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.53.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0"
  }
}
